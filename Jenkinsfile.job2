pipeline {
    agent any

    parameters {
        string(name: 'IMAGE_TAG', defaultValue: 'latest', description: 'Docker image tag to deploy')
    }

    environment {
        REGISTRY = 'ghcr.io'
        IMAGE_NAME = 'manoj24112005/devops-project'
        GHCR_CREDS = credentials('github-token')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Terraform Init & Apply') {
            steps {
                dir('terraform') {
                    bat 'terraform init'
                    bat 'terraform validate'
                    bat 'terraform apply -auto-approve'
                    script {
                        def ipOutput = bat(script: '@terraform output -raw ec2_public_ip', returnStdout: true).trim()
                        def lines = ipOutput.split('\n')
                        env.EC2_IP = lines[lines.length - 1].trim()
                        echo "Target EC2 Public IP: ${env.EC2_IP}"
                    }
                }
            }
        }

        stage('Deploy Container to EC2') {
            steps {
                script {
                    echo "Deploying ${REGISTRY}/${IMAGE_NAME}:${params.IMAGE_TAG} to EC2 (${env.EC2_IP})"
                    
                    def deployScript = """
                        set -e
                        sudo systemctl start docker || true
                        echo "${GHCR_CREDS_PSW}" | sudo docker login ${REGISTRY} -u "${GHCR_CREDS_USR}" --password-stdin
                        sudo docker pull ${REGISTRY}/${IMAGE_NAME}:${params.IMAGE_TAG}
                        sudo docker stop devops-project || true
                        sudo docker rm devops-project || true
                        sudo docker run -d --name devops-project -p 5000:5000 ${REGISTRY}/${IMAGE_NAME}:${params.IMAGE_TAG}
                        echo "Waiting for container startup..."
                        sleep 3
                        sudo docker ps
                        curl -f http://localhost:5000/health
                    """
                    
                    writeFile file: 'deploy_remote.sh', text: deployScript
                    bat "ssh -o StrictHostKeyChecking=no -i devops-project-key.pem ubuntu@%EC2_IP% \"bash -s\" < deploy_remote.sh"
                }
            }
        }

        stage('Health Verification') {
            steps {
                bat "curl http://%EC2_IP%:5000/health"
            }
        }
    }
}
